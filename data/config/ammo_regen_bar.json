{
	# Ammo Regen Bar
	#
	# The bar is not positioned by coordinates any more. The mod finds the weapon
	# row in the game's own HUD, matches it to the weapon by object identity, and
	# attaches an overlay on top of that row's ammo bar. So it follows the HUD by
	# itself: any ship, any weapon names, any UI scale, no numbers to tune.

	"enabled":true,

	# --- appearance -------------------------------------------------------
	# Thickness of the overlay as a fraction of the ammo bar's short side: its
	# height for a horizontal bar, its width for a vertical one. One third
	# leaves the ammo bar readable on both sides of the regen strip.
	"overlayHeightFraction":0.3333,
	# Inset in pixels at both ends of the bar's long axis. 0 means exactly as
	# long as the ammo bar.
	"overlayInsetX":0.0,
	"drawShadow":true,

	# Vertical bar instead of a horizontal one. The ammo bar is roughly 20 by 9
	# pixels, so a vertical bar is short: expect about nine visible steps.
	"vertical":false,
	# Where a horizontal bar sits across the ammo bar: top, center or bottom.
	# Ignored while "vertical" is true.
	"barPosition":"center",
	# Which side a vertical bar sits on: left or right.
	# Ignored while "vertical" is false.
	"verticalSide":"left",

	# Orange by default so it reads apart from the green HUD.
	"colorR":255,
	"colorG":160,
	"colorB":0,
	"colorA":255,

	# --- behaviour --------------------------------------------------------
	# hideWhenFull: no bar once the magazine is full.
	# invert: fill the other way round.
	"hideWhenFull":true,
	"invert":false,

	# --- internals --------------------------------------------------------
	# How often to look for weapon rows that appeared or changed, in seconds.
	"rescanIntervalSeconds":0.5,
	# Accessor on the combat UI that returns the HUD root panel. The mod also
	# tries getWidgetPanel and getScreenPanel on its own.
	"uiRootMethod":"getWidgetPanel",

	# --- diagnostics ------------------------------------------------------
	# debugLog dumps attached overlays and their coordinates into starsector.log.
	# ALT + R reloads this file mid battle, together with the LunaLib settings,
	# which is handy for tuning colour.
	"debugLog":false,
	"debugLogIntervalSeconds":1.0,

	# debugLoud paints the whole ammo bar solid magenta, ignoring ammo state.
	# It answers one question only: does the overlay reach the screen at all.
	# Turn it off once that is settled.
	"debugLoud":false,
}
